{
  "name": "@theaiinc/yggdrasil",
  "version": "0.1.0",
  "description": "Distributed orchestration system for agent containers with auto-scaling",
  "author": "The AI Inc",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "dev": "nodemon --exec \"node --loader ts-node/esm src/orchestration-controller.ts\"",
    "start": "node dist/src/orchestration-controller.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts",
    "docker:build": "docker build -t yggdrasil-agent ./agent",
    "docker:compose": "docker-compose up -d",
    "docker:compose:dev": "docker-compose -f docker-compose.dev.yml up",
    "load:test": "node scripts/load-test.js",
    "health:check": "node scripts/health-check.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "async-lock": "^1.4.0",
    "axios": "^1.6.7",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "nanoid": "^5.0.6",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.0",
    "redis": "^4.6.12",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.24",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "orchestration",
    "distributed-systems",
    "auto-scaling",
    "containers",
    "agents"
  ]
}
