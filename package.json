{
  "name": "@theaiinc/yggdrasil-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Yggdrasil Nx monorepo — orchestration system and runner discovery agent",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "build:yggdrasil": "nx build @theaiinc/yggdrasil",
    "build:ratatoskr": "nx build @theaiinc/yggdrasil-ratatoskr",
    "build:runtime": "nx build @theaiinc/yggdrasil-runtime",
    "test:yggdrasil": "nx test @theaiinc/yggdrasil",
    "test:ratatoskr": "nx test @theaiinc/yggdrasil-ratatoskr",
    "test:runtime": "nx test @theaiinc/yggdrasil-runtime",
    "docker:compose": "docker compose up -d",
    "docker:compose:build": "docker compose build"
  },
  "devDependencies": {
    "nx": "20.8.0"
  }
}
