{
  "title": "Yggdrasil Runner Status",
  "uid": "yggdrasil-runners",
  "tags": ["yggdrasil", "runners"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 5,
  "refresh": "10s",
  "panels": [
    {
      "title": "Total Runners",
      "type": "stat",
      "gridPos": { "h": 6, "w": 3, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "yggdrasil_runners_total{job=\"orchestration-controller\"}",
          "legendFormat": "Total",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Online",
      "type": "stat",
      "gridPos": { "h": 6, "w": 2, "x": 3, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]},
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "yggdrasil_runners_online{job=\"orchestration-controller\"}",
          "legendFormat": "Online",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Offline",
      "type": "stat",
      "gridPos": { "h": 6, "w": 2, "x": 5, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "auto",
        "showPercentChange": false,
        "wideLayout": true
