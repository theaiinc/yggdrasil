      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            {
              "options": {
                "1": { "color": "purple", "text": "" }
              },
              "type": "value"
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "dark-gray", "value": null },
            { "color": "purple", "value": 1 }
