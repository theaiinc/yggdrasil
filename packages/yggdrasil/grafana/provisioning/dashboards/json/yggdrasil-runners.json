{
  "title": "Yggdrasil Runner Status",
  "uid": "yggdrasil-runners",
  "tags": ["yggdrasil", "runners"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "title": "Total Runners",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "yggdrasil_runners_total",
          "legendFormat": "Total",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Online Runners",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "green", "value": 1 }
          ]},
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "yggdrasil_runners_online",
          "legendFormat": "Online",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Offline Runners",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 5 }
          ]},
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "yggdrasil_runners_offline",
          "legendFormat": "Offline",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Runners Over Time",
      "type": "timeseries",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["mean", "max", "min"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 2, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "never", "spanNulls": true, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "yggdrasil_runners_online",
          "legendFormat": "Online",
          "refId": "A"
        },
        {
          "expr": "yggdrasil_runners_offline",
          "legendFormat": "Offline",
          "refId": "B"
        },
        {
          "expr": "yggdrasil_runners_total",
          "legendFormat": "Total",
          "refId": "C"
        }
      ]
    },
    {
      "title": "Server Uptime",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 18 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "yggdrasil_uptime_seconds",
          "legendFormat": "Uptime",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Runner Status Table",
      "type": "table",
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 26 },
      "id": 6,
      "options": {
        "footer": { "countRows": false, "enablePagination": true, "fields": "", "reducer": ["sum"], "show": false },
        "sortBy": [{ "desc": true, "displayName": "Status" }]
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "inspect": false },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null }
          ]}
        }
      },
      "targets": [
        {
          "expr": "yggdrasil_runners_online",
          "format": "table",
          "instant": true,
          "legendFormat": "Online",
          "refId": "A"
        },
        {
          "expr": "yggdrasil_runners_offline",
          "format": "table",
          "instant": true,
          "legendFormat": "Offline",
          "refId": "B"
        },
        {
          "expr": "yggdrasil_runners_total",
          "format": "table",
          "instant": true,
          "legendFormat": "Total",
          "refId": "C"
        }
      ]
    }
  ]
}
