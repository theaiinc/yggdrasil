    {
      "title": "NPM Latest",
      "type": "stat",
      "gridPos": { "h": 6, "w": 3, "x": 17, "y": 0 },
      "id": 22,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
