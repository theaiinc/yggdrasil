          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 },
            { "color": "red", "value": 5 }
          ]},
          "unit": "none"
        }
      },
      "targets": [
        {
          "expr": "yggdrasil_runners_offline{job=\"orchestration-controller\"}",
          "legendFormat": "Offline",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Outdated",
      "type": "stat",
      "gridPos": { "h": 6, "w": 2, "x": 7, "y": 0 },
