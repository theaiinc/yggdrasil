    {
      "title": "Yggdrasil Version",
      "type": "stat",
      "gridPos": { "h": 6, "w": 3, "x": 14, "y": 0 },
      "id": 21,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "textMode": "auto",
        "showPercentChange": false,
        "wideLayout": true
      },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "green" },
          "mappings": [
            {
              "options": {
                "match": "1"
              },
              "type": "value",
              "value": "1"
            }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "none",
          "displayName": "version"
