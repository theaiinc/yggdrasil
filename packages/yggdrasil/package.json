{
  "name": "@theaiinc/yggdrasil",
  "version": "0.3.4",
  "description": "Distributed runner orchestration controller — registration, heartbeat, task dispatch, lease management, Realm lifecycle, and Prometheus metrics for Ratatoskr agents",
  "author": "The AI Inc",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theaiinc/yggdrasil.git",
    "directory": "packages/yggdrasil"
  },
  "homepage": "https://github.com/theaiinc/yggdrasil/blob/main/packages/yggdrasil/README.md",
  "bugs": {
    "url": "https://github.com/theaiinc/yggdrasil/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "dev": "nodemon --exec \"node --loader ts-node/esm src/orchestration-controller.ts\"",
    "start": "node dist/src/orchestration-controller.js",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^8.1.0",
    "nanoid": "^5.0.6",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.24",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestration",
    "runner",
    "yggdrasil",
    "ratatoskr",
    "task-dispatch",
    "lease-management",
    "prometheus",
    "distributed-systems"
  ]
}
