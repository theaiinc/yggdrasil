{
  "name": "@theaiinc/yggdrasiladmin-panel",
  "version": "0.3.7",
  "description": "Grafana panel plugin for managing Yggdrasil runners — update, restart, rotate keys, and monitor agent fleet health directly from Grafana.",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "grafana",
    "plugin",
    "panel",
    "yggdrasil",
    "ratatoskr",
    "admin",
    "orchestration"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theaiinc/yggdrasil.git",
    "directory": "packages/yggdrasil-grafana-plugins"
  },
  "homepage": "https://github.com/theaiinc/yggdrasil/blob/main/packages/yggdrasil-grafana-plugins/README.md",
  "bugs": {
    "url": "https://github.com/theaiinc/yggdrasil/issues"
  },
  "dependencies": {
    "@emotion/css": "^11.13.5",
    "@grafana/data": "^11.3.0",
    "@grafana/runtime": "^11.3.0",
    "@grafana/schema": "^11.3.0",
    "@grafana/ui": "^11.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@grafana/tsconfig": "^2.0.0",
    "@swc/core": "^1.15.0",
    "@swc/helpers": "^0.5.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.0.0",
    "glob": "^11.0.0",
    "imports-loader": "^5.0.0",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "sass": "^1.93.0",
    "sass-loader": "^16.0.0",
    "style-loader": "^4.0.0",
    "swc-loader": "^0.2.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.0",
    "webpack": "^5.104.0",
    "webpack-cli": "^6.0.0",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.0"
  }
}
