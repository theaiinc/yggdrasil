# Yggdrasil API key for Ratatoskr authentication
# Generate a strong random key for production:
#   openssl rand -hex 32
YGGDRASIL_API_KEY=change-me-to-a-secure-random-key

# Yggdrasil server URL for Ratatoskr to register against.
# Can be local (http://localhost:3000) or remote over internet (https://yggdrasil.example.com).
YGGDRASIL_URL=http://localhost:3000
